# Preparation only. Replace hostname/certificate paths after approved provisioning.
limit_req_zone $binary_remote_addr zone=agencyos_login:10m rate=5r/m;
server {
    listen 80;
    server_name agencyos.example.invalid;
    return 301 https://agencyos.example.invalid$request_uri;
}
server {
    listen 443 ssl;
    server_name agencyos.example.invalid;
    ssl_certificate /etc/letsencrypt/live/agencyos.example.invalid/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/agencyos.example.invalid/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 2m;
    access_log off;
    location = /setup { return 403; }
    location = /login {
        limit_req zone=agencyos_login burst=5 nodelay;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass http://127.0.0.1:8000;
    }
    location / {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For "";
        proxy_read_timeout 45;
        proxy_pass http://127.0.0.1:8000;
    }
}
