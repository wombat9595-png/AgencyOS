AGENCYOS_ENV=production
AGENCYOS_DB=/var/lib/agencyos/agencyos.sqlite3
AGENCYOS_STAGING_ROOT=/var/lib/agencyos/staging
AGENCYOS_TRUSTED_HOSTS=agencyos.example.invalid
AGENCYOS_SECRET_KEY_FILE=/etc/agencyos/secrets/session.key
AGENCYOS_BANK_ENCRYPTION_KEY_FILE=/etc/agencyos/secrets/bank.key
AGENCYOS_WEBSITE_FETCH=0
AGENCYOS_AI_PROVIDER=
AGENCYOS_OSM_POLICY_FILE=
