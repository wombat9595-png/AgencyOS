[Unit]
Description=AgencyOS encrypted daily database and staging backup
OnFailure=agencyos-failure@%n.service

[Service]
Type=oneshot
User=agencyos
Group=agencyos
WorkingDirectory=/opt/agencyos
EnvironmentFile=/etc/agencyos/production.env
ExecStart=/opt/agencyos/.venv/bin/python production.py backup --database /var/lib/agencyos/agencyos.sqlite3 --output /var/backups/agencyos --key-file /etc/agencyos/secrets/backup.key --staging-root /var/lib/agencyos/staging
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/agencyos /var/backups/agencyos
